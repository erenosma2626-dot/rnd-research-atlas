# ==============================================================================
# PaperCanvas - Yerel Docker Çevre Değişkenleri (.env.example)
# Bu dosyayı .env olarak kopyalayıp sadece Groq API anahtarınızı girmeniz yeterlidir.
# Tüm servisler (PostgreSQL, MinIO, Redis) Docker Compose ile yerel çalışır.
# ==============================================================================

# LLM & Formül Çıkarma Yapılandırması (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_CLASSIFY_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_DIAGRAM_MODEL=openai/gpt-oss-20b
GROQ_FORMULA_MODEL=openai/gpt-oss-20b

# Formül Çıkarma Modu: hybrid | llm_only
FORMULA_MODE=hybrid
REPORT_LANGUAGE=tr

# Yerel Veritabanı (Docker içi: postgres:5432, Host'tan: localhost:5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=rnd_paper_canvas
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/rnd_paper_canvas

# Yerel Nesne Depolama (MinIO S3 - Docker içi: minio:9000, Host'tan: localhost:9000)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=devadmin
MINIO_ROOT_PASSWORD=devpassword123
MINIO_ACCESS_KEY=devadmin
MINIO_SECRET_KEY=devpassword123
MINIO_BUCKET=papercanvas-documents
MINIO_SECURE=false

# Yerel Redis & Celery Görev Kuyruğu (Docker içi: redis:6379, Host'tan: localhost:6379)
REDIS_URL=redis://localhost:6379/0

# Kimlik Doğrulama (Supabase Auth / JWT)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Vektör Veritabanı Yolu (Yerel Chroma)
CHROMA_PERSIST_DIRECTORY=./chroma_data
